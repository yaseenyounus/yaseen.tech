---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import { profile, socials, experience, education, projects, posts, certifications, credly } from '../data/site';

const badges = import.meta.glob<{ default: ImageMetadata }>('../assets/certs/*.png', { eager: true });
const badge = (file: string) => badges[`../assets/certs/${file}.png`].default;
const year = new Date().getFullYear();
---

<Base>
  <Nav />
  <div class="frame">
    <Hero />

    <Section id="experience" num="01" title="Experience" note={`${experience.length} roles`}>
      <ol class="rows">
        {
          experience.map((j) => (
            <li>
              <a href={j.href} target="_blank" rel="noopener" class:list={['row', 'xp', { now: j.end === 'Now' }]}>
                <span class="mono when">
                  {j.start} — {j.end}
                </span>
                <span class="role">{j.role}</span>
                <span class="company">{j.company}</span>
                <span class="mono faint type">{j.type}</span>
                <span class="arrow faint">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
      <div class="sub mono faint">Education</div>
      <ol class="rows">
        {
          education.map((e) => (
            <li>
              <a href={e.href} target="_blank" rel="noopener" class="row xp">
                <span class="mono when">{e.years}</span>
                <span class="role">{e.degree}</span>
                <span class="company">{e.school}</span>
                <span class="mono faint type">Degree</span>
                <span class="arrow faint">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section id="projects" num="02" title="Projects" note="aws-samples / cdk">
      <p class="lead muted">
        Infrastructure-as-code examples I contributed to <a href="https://github.com/aws-samples/aws-cdk-examples" target="_blank" rel="noopener" class="ul">aws-samples/aws-cdk-examples</a>, the official AWS CDK sample repo.
      </p>
      <ul class="projects">
        {
          projects.map((p, i) => (
            <li class="project">
              <div class="p-top mono faint">
                <span>P—0{i + 1}</span>
                <span>{p.services.join(' · ')}</span>
              </div>
              <h3>{p.title}</h3>
              <p class="muted">{p.blurb}</p>
              <div class="langs">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class="mono">
                    {l.label} <span class="arrow">↗</span>
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </Section>

    <Section id="certs" num="03" title="Certifications" note={`${certifications.length} badges`}>
      <ul class="badges">
        {
          certifications.map((c) => (
            <li>
              <Image src={badge(c.file)} alt="" width={128} height={128} loading="lazy" />
              <span class="b-name">{c.name}</span>
              <span class="mono faint b-level">{c.level}</span>
            </li>
          ))
        }
      </ul>
      <a href={credly} target="_blank" rel="noopener" class="mono more">
        Verify on Credly <span class="arrow">↗</span>
      </a>
    </Section>

    <Section id="writing" num="04" title="Writing" note="medium">
      <ol class="rows">
        {
          posts.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener" class="row post">
                <span class="mono when">{p.date}</span>
                <span class="role">{p.title}</span>
                <span class="arrow faint">↗</span>
              </a>
            </li>
          ))
        }
      </ol>
    </Section>

    <section id="contact" class="rule contact">
      <div class="c-main">
        <span class="mono accent">05</span>
        <h2>Let's talk<span class="accent">_</span></h2>
        <p class="muted">Cloud, platform, security, or anything in between. My inbox is open.</p>
      </div>
      <div class="c-actions">
        <a class="c-row" href={`mailto:${profile.email}`}>
          <span class="mono faint">Email</span>
          <span class="c-val">{profile.email}</span>
          <span class="arrow">↗</span>
        </a>
        <button class="c-row copy" type="button" data-email={profile.email}>
          <span class="mono faint">Clipboard</span>
          <span class="c-val" data-label>Copy address</span>
          <span class="mono accent">⌘C</span>
        </button>
        {
          socials.slice(0, 3).map((s) => (
            <a class="c-row" href={s.href} target="_blank" rel="noopener me">
              <span class="mono faint">{s.label}</span>
              <span class="c-val">{s.href.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
              <span class="arrow">↗</span>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="rule foot">
      <span class="mono faint">© {year} {profile.name}</span>
      <ul class="mono">
        {socials.slice(3).map((s) => <li><a href={s.href} target="_blank" rel="noopener me">{s.label}</a></li>)}
      </ul>
      <span class="mono faint">Chicago · 41.88°N 87.63°W</span>
    </footer>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-email]').forEach((btn) => {
    const label = btn.querySelector('[data-label]')!;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email!);
        label.textContent = 'Copied ✓';
        setTimeout(() => (label.textContent = 'Copy address'), 1600);
      } catch {
        location.href = `mailto:${btn.dataset.email}`;
      }
    });
  });
</script>

<style>
  /* Shared row list */
  .rows li + li {
    border-top: 1px solid var(--line);
  }
  .row {
    position: relative;
    display: grid;
    align-items: center;
    gap: 20px;
    padding: 18px var(--pad);
    transition: background 0.2s;
  }
  .row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.25s var(--ease);
  }
  .row:hover {
    background: var(--hover);
  }
  .row:hover::before {
    transform: scaleY(1);
  }
  .row:hover .arrow {
    color: var(--text);
  }
  .xp {
    grid-template-columns: 110px 1fr 180px 80px 16px;
  }
  .post {
    grid-template-columns: 110px 1fr 16px;
  }
  .when {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .now .when {
    color: var(--accent);
  }
  .role {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .company {
    color: var(--muted);
  }
  .type {
    text-align: right;
  }
  .sub {
    padding: 12px var(--pad);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--panel);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 10.5px;
  }

  /* Projects */
  .lead {
    padding: 40px var(--pad) 28px;
    max-width: 62ch;
  }
  .ul {
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.2s;
  }
  .ul:hover {
    border-color: var(--accent);
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
  }
  .project {
    display: flex;
    flex-direction: column;
    padding: 24px var(--pad) 26px;
    min-height: 260px;
    transition: background 0.2s;
  }
  .project + .project {
    border-left: 1px solid var(--line);
  }
  .project:hover {
    background: var(--hover);
  }
  .p-top {
    display: flex;
    white-space: nowrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
  }
  .project h3 {
    margin-top: 44px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .project p {
    margin-top: 8px;
    font-size: 14px;
  }
  .langs {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    gap: 8px;
  }
  .langs a {
    padding: 5px 10px;
    border: 1px solid var(--line-strong);
    transition: border-color 0.2s, color 0.2s;
  }
  .langs a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Badges */
  .badges {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }
  .badges li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 26px 12px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: background 0.2s;
  }
  .badges li:nth-child(5n) {
    border-right: 0;
  }
  .badges li:hover {
    background: var(--hover);
  }
  .badges img {
    width: 72px;
    height: 72px;
    filter: grayscale(1) brightness(0.9);
    transition: filter 0.4s var(--ease), transform 0.4s var(--ease);
  }
  .badges li:hover img {
    filter: none;
    transform: translateY(-2px);
  }
  .b-name {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.3;
  }
  .b-level {
    margin-top: 4px;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .more {
    display: flex;
    justify-content: space-between;
    padding: 16px var(--pad);
    color: var(--muted);
    transition: color 0.2s, background 0.2s;
  }
  .more:hover {
    color: var(--text);
    background: var(--hover);
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .c-main {
    padding: 72px var(--pad);
    border-right: 1px solid var(--line);
  }
  .c-main h2 {
    margin-top: 14px;
    font-size: clamp(52px, 8vw, 104px);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .c-main h2 .accent {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .c-main p {
    margin-top: 20px;
    max-width: 36ch;
    font-size: 16px;
  }
  .c-actions {
    display: flex;
    flex-direction: column;
  }
  .c-row {
    flex: 1;
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px var(--pad);
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s;
  }
  .c-row:last-child {
    border-bottom: 0;
  }
  .c-row:hover {
    background: var(--hover);
  }
  .c-val {
    font-size: 15px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Footer */
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding: 22px var(--pad);
  }
  .foot ul {
    display: flex;
    gap: 20px;
  }
  .foot ul a {
    color: var(--muted);
    transition: color 0.2s;
  }
  .foot ul a:hover {
    color: var(--accent);
  }

  @media (max-width: 1060px) {
    .xp {
      grid-template-columns: 100px 1fr 150px 16px;
    }
    .type {
      display: none;
    }
    .projects {
      grid-template-columns: 1fr;
    }
    .project + .project {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .project {
      min-height: 0;
    }
    .project h3 {
      margin-top: 24px;
    }
  }
  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
    .c-main {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-block: 56px;
    }
  }
  @media (max-width: 640px) {
    .xp {
      grid-template-columns: 1fr 16px;
      gap: 2px 16px;
    }
    .xp .when {
      grid-row: 1;
    }
    .xp .role {
      grid-row: 2;
    }
    .xp .company {
      grid-row: 3;
      font-size: 14px;
    }
    .xp .arrow {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
    .post {
      grid-template-columns: 1fr 16px;
      gap: 2px 16px;
    }
    .post .arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .badges {
      grid-template-columns: repeat(3, 1fr);
    }
    .badges li:nth-child(5n) {
      border-right: 1px solid var(--line);
    }
    .badges li:nth-child(3n) {
      border-right: 0;
    }
    .badges img {
      width: 56px;
      height: 56px;
    }
    .c-row {
      grid-template-columns: 1fr auto;
      gap: 2px 12px;
    }
    .c-row > .faint {
      grid-column: 1;
    }
    .c-row > .c-val {
      grid-column: 1;
      grid-row: 2;
    }
    .c-row > :last-child {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (hover: none) {
    .badges img {
      filter: none;
    }
  }
</style>
