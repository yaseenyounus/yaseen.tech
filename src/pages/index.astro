---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DotField from '../components/DotField.astro';
import photo from '../assets/yaseen.png';
import { profile, socials, experience, projects, posts, certifications, credly } from '../data/site';

const badges = import.meta.glob<{ default: ImageMetadata }>('../assets/certs/*.png', { eager: true });
const badge = (file: string) => badges[`../assets/certs/${file}.png`].default;
const github = socials.find((s) => s.label === 'GitHub')!;
const linkedin = socials.find((s) => s.label === 'LinkedIn')!;
const medium = socials.find((s) => s.label === 'Medium')!;
---

<Base>
  <header class="nav">
    <div class="nav-inner">
      <a href="#top" class="brand" aria-label="Home">
        <span class="mark">YT</span>
        <span class="brand-name">Yaseen Younus</span>
      </a>
      <nav class="links" aria-label="Primary">
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#writing">Writing</a>
      </nav>
      <a href="#contact" class="nav-cta">Contact</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section id="top" class="hero">
      <DotField />
      <div class="glow" aria-hidden="true"></div>

      <div class="hero-inner container">
        <a href="#experience" class="pill" data-reveal>
          <Image src={photo} alt="" width={48} height={48} class="avatar" loading="eager" />
          <span><span class="live" aria-hidden="true"></span>{profile.role} at {profile.company}</span>
        </a>

        <h1 data-reveal style="--d:80ms">{profile.name}</h1>

        <p class="lede" data-reveal style="--d:160ms">
          I build secure, automated cloud infrastructure. <br class="br" />
          8+ years across AWS, Okta, Everbridge and Abbott.
        </p>

        <div class="cta" data-reveal style="--d:240ms">
          <a class="btn btn-primary" href="#contact">Get in touch</a>
          <a class="btn" href={github.href} target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href={linkedin.href} target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="section container">
      <header class="sec-head" data-reveal>
        <span class="mono label">01</span>
        <h2>Experience</h2>
      </header>
      <ul class="table" data-reveal style="--d:80ms">
        {
          experience.map((j) => (
            <li>
              <a href={j.href} target="_blank" rel="noopener" class="row">
                <span class="logo" aria-hidden="true">{j.company[0]}</span>
                <span class="row-main">
                  <span class="row-title">{j.company}</span>
                  <span class="row-sub">{j.role}</span>
                  <span class="row-yrs-m mono">{j.start} – {j.end === 'Now' ? 'Present' : j.end}</span>
                </span>
                <span class="row-meta mono">
                  {j.end === 'Now' && <span class="now"><span class="live" />Now</span>}
                  <span class="yrs">{j.start} – {j.end === 'Now' ? 'Present' : j.end}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Projects -->
    <section id="projects" class="section container">
      <header class="sec-head" data-reveal>
        <span class="mono label">02</span>
        <h2>Projects</h2>
        <p class="sec-sub">
          Open-source contributions to <a href="https://github.com/aws-samples/aws-cdk-examples" target="_blank" rel="noopener">aws-cdk-examples</a>
        </p>
      </header>
      <ul class="cards">
        {
          projects.map((p, i) => (
            <li class="card" data-reveal style={`--d:${i * 80}ms`}>
              <span class="mono tag">{p.services.join(' · ')}</span>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <span class="langs">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class="mono">
                    {l.label}
                  </a>
                ))}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Certifications -->
    <section id="certs" class="section container">
      <header class="sec-head" data-reveal>
        <span class="mono label">03</span>
        <h2>Certifications</h2>
        <p class="sec-sub">
          {certifications.length} credentials across AWS, HashiCorp and Python. <a href={credly} target="_blank" rel="noopener">Verify on Credly</a>
        </p>
      </header>
      <ul class="badges" data-reveal style="--d:80ms">
        {
          certifications.map((c) => (
            <li title={`${c.name} · ${c.level}`}>
              <Image src={badge(c.file)} alt={`${c.name} ${c.level}`} width={128} height={128} loading="lazy" />
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Writing -->
    <section id="writing" class="section container">
      <header class="sec-head" data-reveal>
        <span class="mono label">04</span>
        <h2>Writing</h2>
        <p class="sec-sub"><a href={medium.href} target="_blank" rel="noopener">All posts on Medium</a></p>
      </header>
      <ul class="table" data-reveal style="--d:80ms">
        {
          posts.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener" class="row">
                <span class="row-main">
                  <span class="row-title">{p.title}</span>
                </span>
                <span class="row-meta mono"><span class="yrs">{p.date}</span></span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Contact -->
    <section id="contact" class="section container contact" data-reveal>
      <h2>Let's build something.</h2>
      <p>Open to conversations about cloud, platform and security engineering.</p>
      <div class="cta">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>Email me</a>
        <button class="btn" type="button" data-copy={profile.email}>
          <span data-copy-label>Copy email</span>
        </button>
      </div>
    </section>
  </main>

  <footer class="foot container">
    <span class="mono">© {new Date().getFullYear()} {profile.name}</span>
    <nav class="foot-links" aria-label="Social">
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener me">{s.label}</a>)}
    </nav>
  </footer>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -5% 0px', threshold: 0.05 },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  const nav = document.querySelector('.nav')!;
  const onScroll = () => nav.classList.toggle('scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.querySelector('[data-copy-label]')!;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        label.textContent = 'Copied';
        setTimeout(() => (label.textContent = 'Copy email'), 1600);
      } catch {
        location.href = `mailto:${b.dataset.copy}`;
      }
    });
  });
</script>

<style>
  /* Nav */
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 12px var(--gutter);
    transition: background 0.3s;
  }
  .nav-inner {
    max-width: 1080px;
    margin: 0 auto;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 0 8px 0 12px;
    border-radius: 14px;
    border: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }
  .nav.scrolled .nav-inner {
    background: rgba(14, 14, 17, 0.72);
    border-color: var(--line);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    font-size: 14.5px;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--text);
    color: #000;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .links {
    margin-left: auto;
    display: flex;
    gap: 2px;
  }
  .links a {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--muted);
    transition: color 0.2s, background 0.2s;
  }
  .links a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
  }
  .nav-cta {
    padding: 7px 14px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 500;
    background: var(--text);
    color: #000;
    transition: opacity 0.2s;
  }
  .nav-cta:hover {
    opacity: 0.85;
  }

  /* Buttons */
  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 0 18px;
    border-radius: 10px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
  }
  .btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.22);
  }
  .btn-primary {
    background: var(--text);
    color: #000;
    border-color: var(--text);
  }
  .btn-primary:hover {
    background: #fff;
    border-color: #fff;
  }

  /* Hero */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: min(100svh, 780px);
    display: flex;
    align-items: center;
    padding: 120px 0 80px;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    left: 50%;
    top: -260px;
    width: min(900px, 140vw);
    height: 520px;
    translate: -50% 0;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(140, 160, 255, 0.16), transparent);
    filter: blur(20px);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 4px 14px 4px 4px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.03);
    font-size: 13.5px;
    color: var(--muted);
    transition: border-color 0.2s, color 0.2s;
  }
  .pill:hover {
    border-color: rgba(255, 255, 255, 0.24);
    color: var(--text);
  }
  .pill > span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  :global(.avatar) {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 22%;
    background: #000;
  }
  .live {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 8px var(--live);
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(48px, 10vw, 104px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(180deg, #ffffff 25%, #8d8d96 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }
  .lede {
    margin-top: 22px;
    max-width: 46ch;
    font-size: clamp(16px, 2vw, 18px);
    line-height: 1.6;
    color: var(--muted);
  }
  .hero .cta {
    margin-top: 36px;
  }

  /* Sections */
  .section {
    padding-top: clamp(80px, 12vw, 128px);
  }
  .sec-head {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 14px;
    margin-bottom: 24px;
  }
  .label {
    color: var(--faint);
  }
  h2 {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .sec-sub {
    grid-column: 2;
    margin-top: 6px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .sec-sub a {
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.2s;
  }
  .sec-sub a:hover {
    border-color: var(--text);
  }

  /* Table-style list */
  .table {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  .table li + li {
    border-top: 1px solid var(--line);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    transition: background 0.2s;
  }
  .row:hover {
    background: var(--surface-hover);
  }
  .logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }
  .row-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .row-title {
    font-weight: 500;
    font-size: 15px;
  }
  .row-sub {
    font-size: 14px;
    color: var(--muted);
  }
  .row-meta {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    color: var(--faint);
  }
  .row-yrs-m {
    display: none;
    margin-top: 4px;
    color: var(--faint);
  }
  .now {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--live);
    background: rgba(61, 220, 151, 0.1);
  }

  /* Project cards */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.25s, background 0.25s;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.18), transparent 40%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }
  .card:hover {
    border-color: var(--line-strong);
    background: var(--surface-hover);
  }
  .tag {
    color: var(--faint);
  }
  .card h3 {
    margin-top: 28px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .card p {
    margin-top: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .langs {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    gap: 6px;
  }
  .langs a {
    padding: 4px 10px;
    border-radius: 7px;
    border: 1px solid var(--line-strong);
    color: var(--muted);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .langs a:hover {
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.28);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Badges */
  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .badges li {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 12px;
    transition: background 0.25s;
  }
  .badges li:hover {
    background: rgba(255, 255, 255, 0.04);
  }
  .badges img {
    width: 58%;
    height: auto;
    filter: saturate(0.6);
    opacity: 0.8;
    transition: filter 0.35s var(--ease), opacity 0.35s var(--ease), transform 0.35s var(--ease);
  }
  .badges li:hover img {
    filter: none;
    opacity: 1;
    transform: scale(1.08);
  }

  /* Contact */
  .contact {
    text-align: center;
    padding-bottom: clamp(80px, 12vw, 128px);
  }
  .contact h2 {
    font-size: clamp(32px, 5.5vw, 52px);
    letter-spacing: -0.045em;
    line-height: 1.05;
    background: linear-gradient(180deg, #ffffff 30%, #8d8d96 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }
  .contact p {
    margin: 14px auto 0;
    max-width: 40ch;
    color: var(--muted);
  }
  .contact .cta {
    margin-top: 28px;
  }

  /* Footer */
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-block: 28px 40px;
    border-top: 1px solid var(--line);
    color: var(--faint);
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 13.5px;
  }
  .foot-links a {
    color: var(--muted);
    transition: color 0.2s;
  }
  .foot-links a:hover {
    color: var(--text);
  }

  /* Responsive */
  @media (max-width: 760px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card h3 {
      margin-top: 18px;
    }
  }
  @media (max-width: 640px) {
    .links {
      display: none;
    }
    .nav-cta {
      margin-left: auto;
    }
    .br {
      display: none;
    }
    .hero {
      min-height: auto;
      padding: 120px 0 24px;
    }
    .hero .cta .btn:first-child {
      flex-basis: 100%;
    }
    .hero .cta .btn {
      flex: 1;
    }
    .row {
      padding: 14px 16px;
      align-items: flex-start;
    }
    .row-meta {
      align-self: center;
    }
    .table .row-yrs-m {
      display: block;
    }
    #experience .row-meta .yrs {
      display: none;
    }
    .section {
      padding-top: 72px;
    }
    .badges {
      padding: 12px 8px;
      gap: 2px;
    }
    .badges li {
      width: 19%;
      height: auto;
      aspect-ratio: 1;
    }
    .badges img {
      width: 70%;
    }
    .foot {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
</style>
