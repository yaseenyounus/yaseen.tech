---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import photo from '../assets/yaseen.png';
import { profile, socials, experience, education, projects, posts, certifications, credly } from '../data/site';

const badges = import.meta.glob<{ default: ImageMetadata }>('../assets/certs/*.png', { eager: true });
const badge = (file: string) => badges[`../assets/certs/${file}.png`].default;
const years = new Date().getFullYear() - profile.careerStart;
const pipeline = [...experience].reverse(); // chronological, flowing into the current role
const primary = socials.slice(0, 3);
const stats = [
  { n: `${years}+`, l: 'Years in cloud & DevOps' },
  { n: `${certifications.length}`, l: 'Certifications' },
  { n: `${experience.length}`, l: 'Companies' },
  { n: 'M.S.', l: 'Northwestern, Data Science & AI' },
];
---

<Base>
  <Header />

  <main>
    <!-- Hero -->
    <section id="top" class="hero container">
      <div class="hero-copy">
        <p class="status" data-reveal>
          <span class="dot" aria-hidden="true"></span>
          {profile.role} at {profile.company}
        </p>
        <h1 data-reveal style="--d:80ms">
          Hi, I'm Yaseen.<br />
          I build <em>secure</em> cloud platforms.
        </h1>
        <p class="lede" data-reveal style="--d:160ms">
          DevSecOps engineer in Chicago with {years}+ years automating infrastructure at AWS, Okta, Everbridge and Abbott.
        </p>
        <div class="actions" data-reveal style="--d:240ms">
          <a class="btn btn-solid" href="#contact">Get in touch</a>
          <a class="btn" href="#work">View my work</a>
        </div>
        <ul class="quick" data-reveal style="--d:300ms">
          {
            primary.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener me">{s.label} ↗</a>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="hero-photo" data-reveal style="--d:120ms">
        <div class="frame">
          <Image src={photo} alt={`Portrait of ${profile.name}`} widths={[400, 640, 900]} sizes="(max-width: 860px) 90vw, 440px" loading="eager" fetchpriority="high" />
        </div>
        <figcaption class="chip chip-loc mono">◎ {profile.location}</figcaption>
        <div class="chip chip-now">
          <span class="mono">Currently</span>
          <strong>{profile.company}</strong>
        </div>
      </figure>
    </section>

    <!-- Stats -->
    <section class="container">
      <ul class="stats">
        {
          stats.map((s, i) => (
            <li data-reveal style={`--d:${i * 70}ms`}>
              <span class="n">{s.n}</span>
              <span class="l">{s.l}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- About -->
    <section id="about" class="section container about">
      <p class="kicker mono" data-reveal>About</p>
      <div class="about-grid">
        <h2 class="statement" data-reveal style="--d:60ms">
          Turning messy infrastructure into <em>calm, automated</em> systems.
        </h2>
        <div class="about-body" data-reveal style="--d:140ms">
          <p>
            I work where cloud, security and automation meet: CI/CD pipelines, infrastructure as code, and guardrails that let teams move fast without breaking things.
          </p>
          <ul class="edu">
            {
              education.map((e) => (
                <li>
                  <a href={e.href} target="_blank" rel="noopener">
                    <span class="edu-deg">{e.degree}</span>
                    <span class="edu-school">{e.school}</span>
                  </a>
                  <span class="mono edu-yr">{e.years}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="section container">
      <div class="sec-head">
        <h2 data-reveal>Career <em>pipeline</em></h2>
        <p class="mono faint" data-reveal style="--d:80ms">{profile.careerStart} → now</p>
      </div>

      <div class="pipe" data-reveal style="--d:120ms">
        <span class="packet" style="--d:0s" aria-hidden="true"></span>
        <span class="packet" style="--d:-2s" aria-hidden="true"></span>
        <span class="packet" style="--d:-4s" aria-hidden="true"></span>
        <ol class="stages">
        {
          pipeline.map((j) => (
            <li class:list={['stage', { now: j.end === 'Now' }]}>
              <span class="node" aria-hidden="true" />
              <a class="job" href={j.href} target="_blank" rel="noopener">
                <span class="mono yrs">
                  {j.start} – {j.end}
                </span>
                <span class="co">{j.company}</span>
                <span class="role">{j.role}</span>
                <span class="meta mono">
                  {j.type} · {j.location}
                </span>
                {j.end === 'Now' && <span class="now-pill mono">Now</span>}
              </a>
            </li>
          ))
        }
        </ol>
      </div>
    </section>

    <!-- Work -->
    <section id="work" class="section container">
      <div class="sec-head">
        <h2 data-reveal>Selected <em>work</em></h2>
        <p class="mono faint" data-reveal style="--d:80ms">Open source</p>
      </div>
      <p class="sec-note" data-reveal>
        AWS CDK examples I contributed to <a href="https://github.com/aws-samples/aws-cdk-examples" target="_blank" rel="noopener">aws-samples/aws-cdk-examples</a>, the official AWS samples repo.
      </p>

      <ul class="work">
        {
          projects.map((p, i) => (
            <li class="card proj" data-reveal style={`--d:${i * 80}ms`}>
              <p class="mono svc">{p.services.join(' · ')}</p>
              <h3>{p.title}</h3>
              <p class="blurb">{p.blurb}</p>
              <div class="langs">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class="mono">
                    {l.label} ↗
                  </a>
                ))}
              </div>
            </li>
          ))
        }
        <li class="card proj arch" data-reveal style="--d:240ms">
          <a href="/architecture" class="arch-link">
            <p class="mono svc">Side quest</p>
            <h3>This site, as an <em>architecture diagram</em></h3>
            <p class="blurb">My career modelled as cloud infrastructure, with live data packets and an inspector.</p>
            <span class="arch-cta mono">Open diagram →</span>
            <svg class="arch-art" viewBox="0 0 200 90" aria-hidden="true">
              <path d="M20 20 H90 V70 H180" />
              <path d="M90 20 H180" />
              <rect x="6" y="12" width="28" height="16" rx="4" />
              <rect x="76" y="12" width="28" height="16" rx="4" />
              <rect x="166" y="12" width="28" height="16" rx="4" />
              <rect x="166" y="62" width="28" height="16" rx="4" />
              <circle r="2.5"><animateMotion dur="3s" repeatCount="indefinite" path="M20 20 H90 V70 H180" /></circle>
              <circle r="2.5"><animateMotion dur="2.4s" begin="-1s" repeatCount="indefinite" path="M90 20 H180" /></circle>
            </svg>
          </a>
        </li>
      </ul>
    </section>

    <!-- Certifications -->
    <section id="certs" class="section container">
      <div class="sec-head">
        <h2 data-reveal><em>{certifications.length}</em> certifications</h2>
        <a class="mono link" href={credly} target="_blank" rel="noopener" data-reveal style="--d:80ms">Verify on Credly ↗</a>
      </div>
      <ul class="badges">
        {
          certifications.map((c, i) => (
            <li data-reveal style={`--d:${(i % 5) * 50}ms`} title={`${c.name} · ${c.level}`}>
              <Image src={badge(c.file)} alt="" width={140} height={140} loading="lazy" />
              <span class="b-name">{c.name}</span>
              <span class="b-lvl mono">{c.level}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Writing -->
    <section id="writing" class="section container">
      <div class="sec-head">
        <h2 data-reveal>Writing</h2>
        <a class="mono link" href={socials[2].href} target="_blank" rel="noopener" data-reveal style="--d:80ms">All posts on Medium ↗</a>
      </div>
      <ul class="posts">
        {
          posts.map((p, i) => (
            <li data-reveal style={`--d:${i * 60}ms`}>
              <a href={p.href} target="_blank" rel="noopener">
                <span class="mono faint">{p.date}</span>
                <span class="p-title">{p.title}</span>
                <span class="p-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Contact -->
    <section id="contact" class="section container contact">
      <div class="contact-card" data-reveal>
        <p class="kicker mono">Contact</p>
        <h2>Let's <em>talk.</em></h2>
        <p class="lede">Questions about cloud, platform engineering or security, or just want to say hi? My inbox is open.</p>
        <div class="actions">
          <a class="btn btn-solid" href={`mailto:${profile.email}`}>Email me</a>
          <button class="btn" type="button" data-copy={profile.email}>Copy email</button>
        </div>
        <ul class="socials">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener me">
                  <span>{s.label}</span>
                        </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <footer class="container foot">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <a href="/architecture" class="mono">View as architecture diagram →</a>
  </footer>
</Base>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -6% 0px', threshold: 0.06 },
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied ✓';
        setTimeout(() => (b.textContent = 'Copy email'), 1600);
      } catch {
        location.href = `mailto:${b.dataset.copy}`;
      }
    }),
  );
</script>

<style>
  .faint {
    color: var(--faint);
  }
  .section {
    padding-block: clamp(72px, 11vw, 128px) 0;
  }
  .kicker {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 11.5px;
  }
  h2 {
    font-size: clamp(34px, 5.2vw, 56px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  h2 em {
    font-size: 1.08em;
    color: var(--accent);
  }
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .link {
    color: var(--muted);
    transition: color 0.2s;
  }
  .link:hover {
    color: var(--accent);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, transform 0.2s var(--ease), color 0.2s;
  }
  .btn:hover {
    border-color: var(--muted);
    transform: translateY(-1px);
  }
  .btn-solid {
    background: var(--accent);
    border-color: var(--accent);
    color: #1a0e02;
  }
  .btn-solid:hover {
    background: #ffb066;
    border-color: #ffb066;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
    padding-top: clamp(112px, 16vh, 160px);
    padding-bottom: clamp(48px, 7vw, 72px);
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 13.5px;
    color: var(--muted);
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.15);
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(40px, 5.4vw, 72px);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  h1 em {
    font-size: 1.1em;
    color: var(--accent);
    padding-right: 0.04em;
  }
  .lede {
    margin-top: 24px;
    max-width: 44ch;
    font-size: clamp(17px, 1.8vw, 19px);
    line-height: 1.55;
    color: var(--muted);
  }
  .hero .actions {
    margin-top: 32px;
  }
  .quick {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 14px;
  }
  .quick a {
    color: var(--muted);
    transition: color 0.2s;
  }
  .quick a:hover {
    color: var(--text);
  }

  .hero-photo {
    position: relative;
    margin: 0;
    justify-self: end;
    width: 100%;
    max-width: 440px;
  }
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 12% -8% -6% 10%;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(255, 154, 60, 0.28), transparent);
    filter: blur(30px);
  }
  .frame {
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    overflow: hidden;
    background: #000;
    border: 1px solid var(--line-strong);
    transform: rotate(1.5deg);
    transition: transform 0.6s var(--ease);
  }
  .hero-photo:hover .frame {
    transform: rotate(0deg) scale(1.01);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .chip {
    position: absolute;
    border-radius: 14px;
    background: rgba(18, 18, 20, 0.78);
    border: 1px solid var(--line-strong);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .chip-loc {
    top: 20px;
    left: -14px;
    padding: 8px 12px;
    color: var(--text);
  }
  .chip-now {
    bottom: 26px;
    right: -16px;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    line-height: 1.3;
  }
  .chip-now span {
    color: var(--muted);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .chip-now strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 26px;
    font-style: italic;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stats li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 26px 20px;
  }
  .stats li + li {
    border-left: 1px solid var(--line);
  }
  .stats li:first-child {
    padding-left: 0;
  }
  .n {
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 56px);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .l {
    font-size: 13.5px;
    color: var(--muted);
  }

  /* About */
  .about-grid {
    margin-top: 20px;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: end;
  }
  .statement em {
    color: var(--accent);
  }
  .about-body p {
    color: var(--muted);
    font-size: 16.5px;
  }
  .edu {
    margin-top: 24px;
    border-top: 1px solid var(--line);
  }
  .edu li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .edu a {
    display: flex;
    flex-direction: column;
  }
  .edu-deg {
    font-weight: 500;
  }
  .edu a:hover .edu-deg {
    color: var(--accent);
  }
  .edu-school {
    font-size: 14px;
    color: var(--muted);
  }
  .edu-yr {
    color: var(--faint);
    white-space: nowrap;
  }

  /* Career pipeline */
  .pipe {
    --inset: calc(100% / 12);
    position: relative;
  }
  .stages {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .pipe::before {
    content: '';
    position: absolute;
    top: 7px;
    left: var(--inset);
    right: var(--inset);
    height: 1px;
    background: linear-gradient(90deg, var(--line-strong), var(--accent));
  }
  .packet {
    position: absolute;
    top: 5px;
    left: var(--inset);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 10px var(--accent);
    animation: flow-x 6s linear infinite;
    animation-delay: var(--d);
  }
  @keyframes flow-x {
    0% {
      left: var(--inset);
      opacity: 0;
    }
    8%,
    92% {
      opacity: 1;
    }
    100% {
      left: calc(100% - var(--inset));
      opacity: 0;
    }
  }
  .stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }
  .node {
    position: relative;
    z-index: 1;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--line-strong);
  }
  .now .node {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .job {
    position: relative;
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 16px;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: border-color 0.25s, transform 0.3s var(--ease), background 0.25s;
  }
  .job:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
    transform: translateY(-3px);
  }
  .now .job {
    border-color: rgba(255, 154, 60, 0.45);
  }
  .yrs {
    color: var(--faint);
    font-size: 11.5px;
  }
  .now .yrs {
    color: var(--accent);
  }
  .co {
    margin-top: 14px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .role {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.4;
  }
  .meta {
    margin-top: auto;
    padding-top: 14px;
    font-size: 11px;
    color: var(--faint);
  }
  .now-pill {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10.5px;
    color: #1a0e02;
    background: var(--accent);
  }

  /* Work */
  .sec-note {
    margin: -16px 0 28px;
    max-width: 60ch;
    color: var(--muted);
  }
  .sec-note a {
    color: var(--text);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.2s;
  }
  .sec-note a:hover {
    border-color: var(--accent);
  }
  .work {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .card {
    position: relative;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: border-color 0.25s, transform 0.3s var(--ease), background 0.25s;
  }
  .card:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }
  .proj {
    display: flex;
    flex-direction: column;
    padding: 28px;
    min-height: 250px;
  }
  .svc {
    color: var(--faint);
  }
  .proj h3 {
    margin-top: 36px;
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .proj h3 em {
    font-size: 1.1em;
    color: var(--accent);
  }
  .blurb {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
    max-width: 40ch;
  }
  .langs {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .langs a {
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--text);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .langs a:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .arch {
    padding: 0;
    background:
      radial-gradient(120% 90% at 100% 100%, rgba(255, 154, 60, 0.12), transparent 60%),
      var(--surface);
  }
  .arch-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px;
  }
  .arch-cta {
    margin-top: auto;
    padding-top: 24px;
    color: var(--accent);
  }
  .arch-art {
    position: absolute;
    right: 24px;
    top: 24px;
    width: 130px;
    opacity: 0.55;
    transition: opacity 0.3s;
  }
  .arch:hover .arch-art {
    opacity: 1;
  }
