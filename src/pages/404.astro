---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Yaseen Younus">
  <main class="nf">
    <p class="mono code">HTTP 404 · NoSuchKey</p>
    <h1>This resource was never provisioned.</h1>
    <p class="mono hint">The requested path isn't part of the stack.</p>
    <a href="/" class="back mono">← Back to the architecture</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    max-width: 720px;
    margin: 0 auto;
    padding: 24px;
    background-image: radial-gradient(#1d2128 1px, transparent 1px);
    background-size: 20px 20px;
  }
  .code {
    color: #f87171;
  }
  h1 {
    font-size: clamp(32px, 6vw, 56px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  .hint {
    color: var(--muted);
  }
  .back {
    margin-top: 12px;
    color: var(--text);
  }
  .back:hover {
    color: #ff9a3c;
  }
</style>
