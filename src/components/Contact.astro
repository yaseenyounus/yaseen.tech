---
import { profile, socials } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<section id="contact" class="section container contact">
  <div class="card panel" data-reveal>
    <span class="eyebrow">Contact</span>
    <h2>
      Let's build<br /><span class="dim">something solid.</span>
    </h2>
    <p>Open to chatting about cloud, platform engineering, security — or tech in general.</p>
    <div class="row">
      <a class="btn btn-primary" href={`mailto:${profile.email}`}>
        <Icon name="mail" size={16} /> Email me
      </a>
      <button class="btn copy" type="button" data-email={profile.email} aria-live="polite">
        <span class="i-copy"><Icon name="copy" size={15} /></span>
        <span class="i-check"><Icon name="check" size={15} /></span>
        <span class="txt">{profile.email}</span>
      </button>
    </div>
    <div class="glow" aria-hidden="true"></div>
  </div>

  <footer>
    <ul class="socials">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener me" aria-label={s.label} title={s.label}>
              <Icon name={s.icon} size={17} />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="fine">
      <span>© {year} {profile.name}</span>
      <a href="#top" class="top">Back to top <Icon name="up" size={13} /></a>
    </div>
  </footer>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-email]').forEach((btn) => {
    const txt = btn.querySelector('.txt')!;
    const original = txt.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.email!);
        btn.classList.add('done');
        txt.textContent = 'Copied to clipboard';
        setTimeout(() => {
          btn.classList.remove('done');
          txt.textContent = original;
        }, 1800);
      } catch {
        window.location.href = `mailto:${btn.dataset.email}`;
      }
    });
  });
</script>

<style>
  .contact {
    padding-bottom: 40px;
  }
  .panel {
    padding: clamp(32px, 7vw, 80px);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h2 {
    margin-top: 20px;
    font-size: clamp(42px, 8vw, 96px);
    line-height: 0.95;
    letter-spacing: -0.05em;
    font-weight: 600;
  }
  .dim {
    color: var(--faint);
  }
  p {
    margin-top: 24px;
    max-width: 40ch;
    color: var(--muted);
    font-size: 16.5px;
  }
  .row {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 13px;
    max-width: 100%;
  }
  .copy .txt {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .i-copy,
  .i-check {
    display: inline-flex;
    flex-shrink: 0;
  }
  .i-check {
    display: none;
    color: var(--accent);
  }
  .copy:global(.done) .i-check {
    display: inline-flex;
  }
  .copy:global(.done) .i-copy {
    display: none;
  }
  .glow {
    position: absolute;
    left: 50%;
    bottom: -60%;
    width: 80%;
    height: 100%;
    translate: -50% 0;
    z-index: -2;
    background: radial-gradient(closest-side, rgba(124, 245, 196, 0.16), rgba(106, 168, 255, 0.08) 50%, transparent);
    filter: blur(20px);
  }

  footer {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 999px;
    color: var(--faint);
    transition: color 0.25s, background 0.25s, transform 0.3s var(--ease);
  }
  .socials a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }
  .fine {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--faint);
  }
  .top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.25s;
  }
  .top:hover {
    color: var(--text);
  }
</style>
