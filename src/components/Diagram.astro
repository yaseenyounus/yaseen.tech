---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/yaseen.png';
import { profile, socials, experience, education, stack, projects, posts, certifications, credly } from '../data/site';

const badges = import.meta.glob<{ default: ImageMetadata }>('../assets/certs/*.png', { eager: true });
const badge = (file: string) => badges[`../assets/certs/${file}.png`].default;
const years = new Date().getFullYear() - profile.careerStart;
const github = socials.find((s) => s.label === 'GitHub')!;
const linkedin = socials.find((s) => s.label === 'LinkedIn')!;

type Cat = 'role' | 'core' | 'edu' | 'stack' | 'bucket' | 'repo' | 'feed' | 'mail';
const kind: Record<Cat, string> = {
  role: 'career::role',
  core: 'compute::instance',
  edu: 'source::education',
  stack: 'layer::toolbox',
  bucket: 'storage::bucket',
  repo: 'code::repository',
  feed: 'content::feed',
  mail: 'network::endpoint',
};

// Desktop edges: [from, fromSide, to, toSide]
const edges: [string, string, string, string][] = [
  ['abbott', 'r', 'everbridge', 'l'],
  ['everbridge', 'r', 'aws', 'l'],
  ['aws', 'r', 'bridgeview', 'l'],
  ['bridgeview', 'r', 'perficient', 'l'],
  ['perficient', 'r', 'okta', 'l'],
  ['okta', 'b', 'yaseen', 't'],
  ['education', 'r', 'yaseen', 'l'],
  ['toolbox', 'l', 'yaseen', 'r'],
  ['yaseen', 'b', 'certs', 't'],
  ['yaseen', 'b', 'projects', 't'],
  ['yaseen', 'b', 'writing', 't'],
  ['yaseen', 'b', 'contact', 't'],
];

// Boot order (chronological pipeline, then inputs, core, outputs)
const bootOrder = [
  'abbott', 'everbridge', 'aws', 'bridgeview', 'perficient', 'okta',
  'education', 'toolbox', 'yaseen', 'certs', 'projects', 'writing', 'contact',
];

const handle = (href: string) => href.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<div class="app">
  <!-- Console bar -->
  <header class="bar">
    <a href="/" class="brand" aria-label="yaseen.tech home"><span class="mark">YT</span></a>
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <span class="dim hide-sm">yaseen.tech</span>
      <span class="sep hide-sm">/</span>
      <span class="dim hide-sm">chicago-1</span>
      <span class="sep hide-sm">/</span>
      <h1>yaseen-younus</h1>
    </nav>
    <div class="bar-right mono">
      <span class="status" data-status><i></i><span data-status-text>Deploying stack…</span></span>
      <span class="clock hide-sm" data-clock data-tz={profile.timezone}>--:--:--</span>
    </div>
  </header>

  <div class="workspace">
    <!-- Diagram canvas -->
    <main class="canvas-wrap">
      <div class="canvas-head mono">
        <span>Architecture</span>
        <span class="dim"><span class="hide-xs">· {bootOrder.length} resources </span>· select a node</span>
      </div>

      <div class="canvas" data-canvas data-edges={JSON.stringify(edges)} data-boot={JSON.stringify(bootOrder)}>
        <svg class="wires" data-wires aria-hidden="true"></svg>

        <!-- Group boxes (desktop) -->
        <div class="group g-career" aria-hidden="true"><span class="mono">vpc / career-pipeline · {profile.careerStart} → now</span></div>
        <div class="group g-out" aria-hidden="true"><span class="mono">outputs</span></div>

        <!-- Core -->
        <button class="node core" data-id="yaseen" data-cat="core" style="--c: var(--c-core)" aria-pressed="true">
          <Image src={photo} alt="" width={88} height={88} class="avatar" loading="eager" />
          <span class="core-txt">
            <span class="nm">{profile.name}</span>
            <span class="sb core-role">{profile.role}</span>
            <span class="core-meta mono"><span class="run"><i></i>running</span><span>uptime {years}y+</span><span class="hide-md">devsecops.xlarge</span></span>
          </span>
        </button>

        <span class="mlabel mono">Career pipeline</span>

        {
          experience.map((j) => (
            <button class:list={['node', 'role', { prod: j.end === 'Now' }]} data-id={j.id} data-cat="role" style="--c: var(--c-role)" aria-pressed="false">
              <span class="ico"><Icon name="role" /></span>
              <span class="yr mono">{j.start}–{j.end === 'Now' ? 'now' : j.end.slice(2)}</span>
              <span class="nm">{j.company}</span>
              <span class="sb">{j.short}</span>
              {j.end === 'Now' && <span class="tag mono">PROD</span>}
            </button>
          ))
        }

        <span class="mlabel mono">Inputs</span>

        <button class="node" data-id="education" data-cat="edu" style="--c: var(--c-edu)" aria-pressed="false">
          <span class="ico"><Icon name="edu" /></span>
          <span class="yr mono">2 sources</span>
          <span class="nm">Education</span>
          <span class="sb">M.S. Northwestern</span>
        </button>

        <button class="node" data-id="toolbox" data-cat="stack" style="--c: var(--c-stack)" aria-pressed="false">
          <span class="ico"><Icon name="stack" /></span>
          <span class="yr mono">{stack.length} layers</span>
          <span class="nm">Toolbox</span>
          <span class="sb">AWS · Terraform · Go</span>
        </button>

        <span class="mlabel mono">Outputs</span>

        <button class="node" data-id="certs" data-cat="bucket" style="--c: var(--c-bucket)" aria-pressed="false">
          <span class="ico"><Icon name="bucket" /></span>
          <span class="yr mono">{certifications.length} objects</span>
          <span class="nm">Certifications</span>
          <span class="sb">AWS Pro · Specialty</span>
        </button>

        <button class="node" data-id="projects" data-cat="repo" style="--c: var(--c-repo)" aria-pressed="false">
          <span class="ico"><Icon name="repo" /></span>
          <span class="yr mono">{projects.length} stacks</span>
          <span class="nm">Projects</span>
          <span class="sb">aws-cdk-examples</span>
        </button>

        <button class="node" data-id="writing" data-cat="feed" style="--c: var(--c-feed)" aria-pressed="false">
          <span class="ico"><Icon name="feed" /></span>
          <span class="yr mono">{posts.length} posts</span>
          <span class="nm">Writing</span>
          <span class="sb">on Medium</span>
        </button>

        <button class="node" data-id="contact" data-cat="mail" style="--c: var(--c-mail)" aria-pressed="false">
          <span class="ico"><Icon name="mail" /></span>
          <span class="yr mono">open</span>
          <span class="nm">Contact</span>
          <span class="sb">Say hello</span>
        </button>
      </div>

      <ul class="legend mono" aria-hidden="true">
        <li style="--c: var(--c-role)">role</li>
        <li style="--c: var(--c-edu)">source</li>
        <li style="--c: var(--c-stack)">layer</li>
        <li style="--c: var(--c-bucket)">storage</li>
        <li style="--c: var(--c-repo)">code</li>
        <li style="--c: var(--c-feed)">content</li>
        <li style="--c: var(--c-mail)">endpoint</li>
      </ul>
    </main>

    <!-- Inspector -->
    <aside class="insp" data-insp aria-label="Resource inspector" aria-live="polite">
      <div class="insp-bar mono">
        <span>Inspector</span>
        <button class="close" data-close aria-label="Close inspector">esc ✕</button>
      </div>

      <!-- Core -->
      <section class="detail" data-for="yaseen">
        <div class="photo">
          <Image src={photo} alt={`Portrait of ${profile.name}`} widths={[360, 720]} sizes="360px" />
        </div>
        <header class="d-head">
          <span class="mono kind">{kind.core}</span>
          <h2>{profile.name}</h2>
        </header>
        <p class="d-text">{profile.intro}</p>
        <dl class="props">
          <div><dt>role</dt><dd>{profile.role}</dd></div>
          <div><dt>company</dt><dd>{profile.company}</dd></div>
          <div><dt>region</dt><dd>{profile.location}</dd></div>
          <div><dt>uptime</dt><dd>{years}+ years</dd></div>
          <div><dt>status</dt><dd class="ok">● running</dd></div>
        </dl>
        <div class="d-actions">
          <a class="btn solid" href={`mailto:${profile.email}`}>Email</a>
          <a class="btn" href={github.href} target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn" href={linkedin.href} target="_blank" rel="noopener">LinkedIn ↗</a>
        </div>
      </section>

      <!-- Roles -->
      {
        experience.map((j) => (
          <section class="detail" data-for={j.id} hidden>
            <header class="d-head">
              <span class="mono kind" style="--c: var(--c-role)">{kind.role}</span>
              <h2>{j.company}</h2>
              <p class="d-sub">{j.role}</p>
            </header>
            <dl class="props">
              <div><dt>period</dt><dd>{j.start} → {j.end}</dd></div>
              <div><dt>engagement</dt><dd>{j.type}</dd></div>
              <div><dt>location</dt><dd>{j.location}</dd></div>
              <div>
                <dt>status</dt>
                <dd class={j.end === 'Now' ? 'ok' : 'dim'}>{j.end === 'Now' ? '● running (prod)' : '○ completed'}</dd>
              </div>
            </dl>
            <div class="d-actions">
              <a class="btn" href={j.href} target="_blank" rel="noopener">{handle(j.href)} ↗</a>
            </div>
          </section>
        ))
      }

      <!-- Education -->
      <section class="detail" data-for="education" hidden>
        <header class="d-head">
          <span class="mono kind" style="--c: var(--c-edu)">{kind.edu}</span>
          <h2>Education</h2>
        </header>
        <ul class="list">
          {
            education.map((e) => (
              <li>
                <a href={e.href} target="_blank" rel="noopener">
                  <span class="l-main">{e.degree}</span>
                  <span class="l-sub">{e.school}</span>
                  <span class="l-meta mono">{e.years}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Toolbox -->
      <section class="detail" data-for="toolbox" hidden>
        <header class="d-head">
          <span class="mono kind" style="--c: var(--c-stack)">{kind.stack}</span>
          <h2>Toolbox</h2>
          <p class="d-sub">What I build and run with day to day.</p>
        </header>
        <ul class="chips mono">{stack.map((s) => <li>{s}</li>)}</ul>
      </section>

      <!-- Certs -->
      <section class="detail" data-for="certs" hidden>
        <header class="d-head">
          <span class="mono kind" style="--c: var(--c-bucket)">{kind.bucket}</span>
          <h2>Certifications</h2>
          <p class="d-sub">s3://yaseen/certs · {certifications.length} objects</p>
        </header>
        <ul class="badges">
          {
            certifications.map((c) => (
              <li title={`${c.name} · ${c.level}`}>
                <Image src={badge(c.file)} alt={`${c.name} ${c.level}`} width={112} height={112} loading="lazy" />
                <span class="b-name">{c.name}</span>
                <span class="b-lvl mono">{c.level}</span>
              </li>
            ))
          }
        </ul>
        <div class="d-actions">
          <a class="btn" href={credly} target="_blank" rel="noopener">Verify on Credly ↗</a>
        </div>
      </section>

      <!-- Projects -->
      <section class="detail" data-for="projects" hidden>
        <header class="d-head">
          <span class="mono kind" style="--c: var(--c-repo)">{kind.repo}</span>
          <h2>Projects</h2>
          <p class="d-sub">
            CDK stacks I contributed to <a href="https://github.com/aws-samples/aws-cdk-examples" target="_blank" rel="noopener">aws-samples/aws-cdk-examples</a>.
          </p>
        </header>
        <ul class="list">
          {
            projects.map((p) => (
              <li class="proj">
                <span class="l-main">{p.title}</span>
                <span class="l-sub">{p.blurb}</span>
                <span class="langs mono">
                  {p.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
                  ))}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Writing -->
      <section class="detail" data-for="writing" hidden>
        <header class="d-head">
          <span class="mono kind" style="--c: var(--c-feed)">{kind.feed}</span>
          <h2>Writing</h2>
        </header>
        <ul class="list">
          {
            posts.map((p) => (
              <li>
                <a href={p.href} target="_blank" rel="noopener">
                  <span class="l-main">{p.title} ↗</span>
                  <span class="l-meta mono">{p.date}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Contact -->
      <section class="detail" data-for="contact" hidden>
        <header class="d-head">
          <span class="mono kind" style="--c: var(--c-mail)">{kind.mail}</span>
          <h2>Contact</h2>
          <p class="d-sub">Cloud, platform, security, or anything in between.</p>
        </header>
        <div class="d-actions">
          <a class="btn solid" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button class="btn" type="button" data-copy={profile.email}>Copy</button>
        </div>
        <ul class="list">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener me">
                  <span class="l-main">{s.label}</span>
                  <span class="l-meta mono">{handle(s.href)}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </aside>
  </div>

  <footer class="foot mono">
    <span>© {new Date().getFullYear()} {profile.name}</span>
    <span class="dim">Built with Astro · deployed via GitHub Actions</span>
  </footer>
</div>

<script>
  type Edge = [string, string, string, string];
  const SVGNS = 'http://www.w3.org/2000/svg';
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobileMq = matchMedia('(max-width: 1199px)');

  const canvas = document.querySelector<HTMLElement>('[data-canvas]')!;
  const wires = canvas.querySelector<SVGSVGElement>('[data-wires]')!;
  const nodes = [...canvas.querySelectorAll<HTMLButtonElement>('.node')];
  const byId = new Map(nodes.map((n) => [n.dataset.id!, n]));
  const desktopEdges: Edge[] = JSON.parse(canvas.dataset.edges!);
  const boot: string[] = JSON.parse(canvas.dataset.boot!);
  const insp = document.querySelector<HTMLElement>('[data-insp]')!;
  const details = [...insp.querySelectorAll<HTMLElement>('.detail')];
  let selected = 'yaseen';

  function currentEdges(): Edge[] {
    if (!mobileMq.matches) return desktopEdges;
    // Mobile: a single spine through the nodes in DOM order
    const order = nodes.map((n) => n.dataset.id!);
    return order.slice(1).map((id, i) => [order[i], 'b', id, 't'] as Edge);
  }

  function anchor(el: HTMLElement, side: string) {
    const c = canvas.getBoundingClientRect();
    const r = el.getBoundingClientRect();
    const x = r.left - c.left;
    const y = r.top - c.top;
    if (mobileMq.matches) {
      const ax = x + 34; // align with icon column
      return side === 't' ? { x: ax, y } : { x: ax, y: y + r.height };
    }
    switch (side) {
      case 'l': return { x, y: y + r.height / 2 };
      case 'r': return { x: x + r.width, y: y + r.height / 2 };
      case 't': return { x: x + r.width / 2, y };
      default: return { x: x + r.width / 2, y: y + r.height };
    }
  }

  function route(a: { x: number; y: number }, b: { x: number; y: number }, side: string) {
    const R = 8;
    if (side === 'l' || side === 'r') {
      if (Math.abs(a.y - b.y) < 1) return `M${a.x},${a.y} H${b.x}`;
      const mx = (a.x + b.x) / 2;
      const sy = Math.sign(b.y - a.y);
      const sx1 = Math.sign(mx - a.x);
      const sx2 = Math.sign(b.x - mx);
      return `M${a.x},${a.y} H${mx - sx1 * R} Q${mx},${a.y} ${mx},${a.y + sy * R} V${b.y - sy * R} Q${mx},${b.y} ${mx + sx2 * R},${b.y} H${b.x}`;
    }
    if (Math.abs(a.x - b.x) < 1) return `M${a.x},${a.y} V${b.y}`;
    const my = (a.y + b.y) / 2;
    const sx = Math.sign(b.x - a.x);
    return `M${a.x},${a.y} V${my - R} Q${a.x},${my} ${a.x + sx * R},${my} H${b.x - sx * R} Q${b.x},${my} ${b.x},${my + R} V${b.y}`;
  }

  function draw() {
    const c = canvas.getBoundingClientRect();
    wires.setAttribute('viewBox', `0 0 ${c.width} ${c.height}`);
    wires.innerHTML = '';
    for (const [from, fs, to, ts] of currentEdges()) {
      const A = byId.get(from), B = byId.get(to);
      if (!A || !B) continue;
      const d = route(anchor(A, fs), anchor(B, ts), fs);
      const g = document.createElementNS(SVGNS, 'g');
      g.setAttribute('class', 'wire');
      g.dataset.from = from;
      g.dataset.to = to;
      const p = document.createElementNS(SVGNS, 'path');
      p.setAttribute('d', d);
      p.setAttribute('pathLength', '1');
      g.appendChild(p);
      if (!reduce) {
        const len = (() => {
          const t = document.createElementNS(SVGNS, 'path');
          t.setAttribute('d', d);
          wires.appendChild(t);
          const l = t.getTotalLength();
          t.remove();
          return l;
        })();
        const dur = Math.max(1.4, len / 90);
        const dot = document.createElementNS(SVGNS, 'circle');
        dot.setAttribute('r', '2.5');
        dot.setAttribute('class', 'packet');
        dot.style.setProperty('--c', getComputedStyle(A).getPropertyValue('--c'));
        const m = document.createElementNS(SVGNS, 'animateMotion');
        m.setAttribute('dur', `${dur.toFixed(2)}s`);
        m.setAttribute('repeatCount', 'indefinite');
        m.setAttribute('path', d);
        m.setAttribute('begin', `-${(Math.random() * dur).toFixed(2)}s`);
        dot.appendChild(m);
        g.appendChild(dot);
      }
      wires.appendChild(g);
    }
    highlight();
  }

  function highlight() {
    wires.querySelectorAll<SVGGElement>('.wire').forEach((w) => {
      w.classList.toggle('hot', w.dataset.from === selected || w.dataset.to === selected);
    });
  }

  function select(id: string, open = true) {
    selected = id;
    nodes.forEach((n) => n.setAttribute('aria-pressed', String(n.dataset.id === id)));
    details.forEach((d) => (d.hidden = d.dataset.for !== id));
    insp.scrollTop = 0;
    highlight();
    if (open && mobileMq.matches) {
      insp.classList.add('open');
      document.body.classList.add('sheet-open');
    }
  }

  function closeSheet() {
    insp.classList.remove('open');
    document.body.classList.remove('sheet-open');
  }

  nodes.forEach((n) => n.addEventListener('click', () => select(n.dataset.id!)));
  insp.querySelector('[data-close]')!.addEventListener('click', closeSheet);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeSheet();
  });

  // Copy email
  insp.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied ✓';
        setTimeout(() => (b.textContent = 'Copy'), 1500);
      } catch {
        location.href = `mailto:${b.dataset.copy}`;
      }
    }),
  );

  // Redraw on layout changes
  new ResizeObserver(() => draw()).observe(canvas);
  mobileMq.addEventListener('change', () => {
    closeSheet();
    draw();
  });

  // Boot / provisioning sequence
  const statusText = document.querySelector('[data-status-text]')!;
  const status = document.querySelector('[data-status]')!;
  const finish = () => {
    canvas.classList.add('live');
    status.classList.add('ok');
    statusText.textContent = 'All systems operational';
  };
  if (reduce) {
    finish();
  } else {
    canvas.classList.add('booting');
    boot.forEach((id, i) => {
      setTimeout(() => {
        byId.get(id)?.classList.add('up');
        statusText.textContent = `Provisioning ${i + 1}/${boot.length}`;
        if (i === boot.length - 1) setTimeout(finish, 250);
      }, 250 + i * 85);
    });
  }

  // Live clock
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
      timeZone: clock.dataset.tz, timeZoneName: 'short',
    });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 1000);
  }

  select('yaseen', false);
</script>

<style>
  .app {
    --c-role: #ff9a3c;
    --c-core: #f2f2f2;
    --c-edu: #2dd4bf;
    --c-stack: #a78bfa;
    --c-bucket: #4ade80;
    --c-repo: #60a5fa;
    --c-feed: #f472b6;
    --c-mail: #f87171;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }
  .dim {
    color: var(--faint);
  }

  /* ---------- Console bar ---------- */
  .bar {
    position: sticky;
    top: 0;
    z-index: 30;
    height: 52px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(10, 11, 13, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .mark {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: var(--c-role);
    color: #000;
    font-weight: 700;
    font-size: 11px;
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .crumbs h1 {
    font: inherit;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sep {
    color: #333a44;
  }
  .bar-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    white-space: nowrap;
  }
  .status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #eab308;
    animation: blink 0.8s steps(1) infinite;
  }
  .status:global(.ok) i {
    background: #4ade80;
    animation: none;
    box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.15);
  }
  .clock {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  /* ---------- Workspace ---------- */
  .workspace {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 380px;
    min-height: 0;
  }
  .canvas-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px clamp(20px, 3vw, 44px) 24px;
    background-color: #0b0c0e;
    background-image: radial-gradient(#1d2128 1px, transparent 1px);
    background-size: 20px 20px;
    min-width: 0;
  }
  .canvas-head {
    color: var(--text);
    margin-bottom: 28px;
  }

  .canvas {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto auto;
    column-gap: 22px;
    row-gap: 84px;
    align-content: center;
    padding: 34px 18px 18px;
  }
  .wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }
  .wires :global(.wire path) {
    fill: none;
    stroke: #2b313b;
    stroke-width: 1.25;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke 0.3s, stroke-dashoffset 1.1s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .canvas:not(:global(.booting)) .wires :global(.wire path),
  .canvas:global(.live) .wires :global(.wire path) {
    stroke-dashoffset: 0;
  }
  .wires :global(.wire.hot path) {
    stroke: #6b7686;
  }
  .wires :global(.packet) {
    fill: var(--c);
    opacity: 0;
    transition: opacity 0.6s;
  }
  .canvas:global(.live) .wires :global(.packet) {
    opacity: 0.9;
  }

  /* Groups */
  .group {
    position: relative;
    z-index: 0;
    margin: -34px -14px -14px;
    border: 1px dashed #2a2f37;
    border-radius: 12px;
    pointer-events: none;
  }
  .group span {
    position: absolute;
    top: 10px;
    left: 14px;
    font-size: 11px;
    color: var(--faint);
  }
  .g-career {
    grid-column: 1 / 13;
    grid-row: 1;
  }
  .g-out {
    grid-column: 1 / 13;
    grid-row: 3;
  }
  .mlabel {
    display: none;
  }

  /* Nodes */
  .node {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'ico yr'
      'nm nm'
      'sb sb';
    align-items: center;
    gap: 2px 10px;
    padding: 12px;
    text-align: left;
    font: inherit;
    color: inherit;
    background: #111317;
    border: 1px solid #232831;
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, transform 0.2s, opacity 0.45s, translate 0.45s;
  }
  .node:hover {
    border-color: #3a414c;
    background: #14171c;
  }
  .node[aria-pressed='true'] {
    border-color: var(--c);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent);
  }
  .canvas:global(.booting) .node:not(:global(.up)) {
    opacity: 0;
    translate: 0 8px;
  }
  .ico {
    grid-area: ico;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
    margin-bottom: 10px;
  }
  .yr {
    grid-area: yr;
    white-space: nowrap;
    justify-self: end;
    align-self: start;
    font-size: 10.5px;
    color: var(--faint);
  }
  .nm {
    grid-area: nm;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sb {
    grid-area: sb;
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tag {
    position: absolute;
    top: -9px;
    right: 10px;
    padding: 1px 7px;
    border-radius: 4px;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: #000;
    background: var(--c-role);
  }
  .prod {
    border-color: color-mix(in srgb, var(--c-role) 45%, #232831);
  }

  /* Desktop placement */
  [data-id='abbott'] { grid-column: 1 / 3; grid-row: 1; }
  [data-id='everbridge'] { grid-column: 3 / 5; grid-row: 1; }
  [data-id='aws'] { grid-column: 5 / 7; grid-row: 1; }
  [data-id='bridgeview'] { grid-column: 7 / 9; grid-row: 1; }
  [data-id='perficient'] { grid-column: 9 / 11; grid-row: 1; }
  [data-id='okta'] { grid-column: 11 / 13; grid-row: 1; }
  [data-id='education'] { grid-column: 1 / 4; grid-row: 2; align-self: center; }
  [data-id='yaseen'] { grid-column: 5 / 9; grid-row: 2; }
  [data-id='toolbox'] { grid-column: 10 / 13; grid-row: 2; align-self: center; }
  [data-id='certs'] { grid-column: 1 / 4; grid-row: 3; }
  [data-id='projects'] { grid-column: 4 / 7; grid-row: 3; }
  [data-id='writing'] { grid-column: 7 / 10; grid-row: 3; }
  [data-id='contact'] { grid-column: 10 / 13; grid-row: 3; }

  /* Core node */
  .core {
    grid-template-columns: auto 1fr;
    grid-template-areas: none;
    gap: 16px;
    padding: 16px;
    background: #15181d;
    border-color: #343b46;
  }
  .core[aria-pressed='true'] {
    border-color: #f2f2f2;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08), 0 20px 50px -20px rgba(0, 0, 0, 0.8);
  }
  .core :global(.avatar) {
    width: 64px;
    height: 64px;
    border-radius: 10px;
    object-fit: cover;
    object-position: 50% 25%;
    background: #000;
  }
  .core-txt {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .core .nm {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .core .sb {
    font-size: 13px;
    white-space: normal;
  }
  .core-meta {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: 10.5px;
    color: var(--faint);
  }
  .run {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #4ade80;
  }
  .run i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.3;
    }
  }

  .legend {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 11px;
    color: var(--faint);
  }
  .legend li::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 2px;
    background: var(--c);
  }

  /* ---------- Inspector ---------- */
  .insp {
    position: sticky;
    top: 52px;
    height: calc(100svh - 52px);
    overflow-y: auto;
    border-left: 1px solid var(--line);
    background: #0d0e11;
    overscroll-behavior: contain;
  }
  .insp-bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    border-bottom: 1px solid var(--line);
    background: #0d0e11;
    color: var(--muted);
  }
  .close {
    display: none;
    font: inherit;
    color: var(--muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 8px;
    cursor: pointer;
  }
  .detail {
    padding: 22px 20px 32px;
    animation: fadein 0.3s ease;
  }
  @keyframes fadein {
    from {
      opacity: 0;
      translate: 0 4px;
    }
  }
  .photo {
    margin: -22px -20px 20px;
    aspect-ratio: 4 / 3;
    background: #000;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }
  .kind {
    font-size: 11px;
    color: var(--c, var(--muted));
  }
  .d-head h2 {
    margin-top: 6px;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .d-sub {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
  }
  .d-sub a,
  .d-text a {
    color: var(--text);
    border-bottom: 1px solid #3a414c;
  }
  .d-text {
    margin-top: 12px;
    color: var(--muted);
    font-size: 14.5px;
  }
  .props {
    margin: 20px 0 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .props div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 12px;
    font-size: 13.5px;
  }
  .props div + div {
    border-top: 1px solid var(--line);
  }
  .props dt {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--faint);
  }
  .props dd {
    margin: 0;
    text-align: right;
  }
  .ok {
    color: #4ade80;
  }
  .d-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: 8px;
    border: 1px solid #2b313b;
    background: #13161a;
    color: var(--text);
    font: 500 13px var(--sans);
    cursor: pointer;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: border-color 0.2s, background 0.2s;
  }
  .btn:hover {
    border-color: #4a525e;
  }
  .btn.solid {
    background: var(--text);
    color: #000;
    border-color: var(--text);
  }
  .btn.solid:hover {
    background: #fff;
  }

  .list {
    margin-top: 18px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .list li + li {
    border-top: 1px solid var(--line);
  }
  .list a,
  .list .proj {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 12px;
    padding: 11px 12px;
    transition: background 0.2s;
  }
  .list a:hover {
    background: #14171c;
  }
  .l-main {
    font-size: 14px;
    font-weight: 500;
  }
  .l-sub {
    grid-column: 1;
    font-size: 13px;
    color: var(--muted);
  }
  .l-meta {
    grid-column: 2;
    grid-row: 1;
    font-size: 11.5px;
    color: var(--faint);
  }
  .proj {
    grid-template-columns: 1fr;
  }
  .langs {
    margin-top: 8px;
    display: flex;
    gap: 6px;
  }
  .langs a {
    padding: 3px 8px;
    border: 1px solid #2b313b;
    border-radius: 5px;
    font-size: 11.5px;
    color: var(--c-repo);
    transition: border-color 0.2s;
  }
  .langs a:hover {
    border-color: var(--c-repo);
  }
  .chips {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chips li {
    padding: 5px 10px;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--c-stack) 30%, transparent);
    background: color-mix(in srgb, var(--c-stack) 8%, transparent);
    color: #d4ccfb;
  }
  .badges {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }
  .badges li {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 12px 6px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .badges img {
    width: 52px;
    height: 52px;
  }
  .b-name {
    margin-top: 8px;
    font-size: 11.5px;
    line-height: 1.25;
  }
  .b-lvl {
    margin-top: 2px;
    font-size: 9.5px;
    color: var(--faint);
    text-transform: uppercase;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 14px 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }

  @media (max-width: 1280px) {
    .hide-md {
      display: none;
    }
    .ico {
      width: 28px;
      height: 28px;
    }
    .ico :global(svg) {
      width: 15px;
      height: 15px;
    }
    .yr {
      font-size: 10px;
    }
    .sb {
      font-size: 12px;
    }
    .workspace {
      grid-template-columns: 1fr 340px;
    }
    .canvas {
      column-gap: 14px;
    }
    .node {
      padding: 10px;
    }
    .nm {
      font-size: 14px;
    }
  }

  /* ---------- Mobile / tablet: vertical pipeline + bottom sheet ---------- */
  @media (max-width: 1199px) {
    .hide-sm {
      display: none;
    }
    .workspace {
      display: block;
    }
    .canvas-head {
      margin-bottom: 12px;
    }
    .canvas {
      display: flex;
      flex-direction: column;
      gap: 18px;
      padding: 8px 0 0;
    }
    .group {
      display: none;
    }
    .mlabel {
      display: block;
      position: relative;
      z-index: 2;
      align-self: flex-start;
      margin: 10px 0 -6px 50px;
      padding: 2px 8px;
      font-size: 10.5px;
      color: var(--faint);
      background: #0b0c0e;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .node {
      align-self: stretch;
      grid-template-columns: auto 1fr auto;
      grid-template-areas:
        'ico nm yr'
        'ico sb yr';
      gap: 0 14px;
      padding: 12px 14px 12px 12px;
    }
    .ico {
      margin: 0;
      width: 44px;
      height: 44px;
    }
    .ico :global(svg) {
      width: 18px;
      height: 18px;
    }
    .yr {
      align-self: center;
    }
    .core {
      grid-template-columns: auto 1fr;
      grid-template-areas: none;
    }
    .core :global(.avatar) {
      width: 44px;
      height: 44px;
    }
    .legend {
      display: none;
    }

    .insp {
      position: fixed;
      inset: auto 0 0;
      top: auto;
      z-index: 60;
      height: auto;
      max-height: 82svh;
      border-left: 0;
      border-top: 1px solid #2b313b;
      border-radius: 16px 16px 0 0;
      box-shadow: 0 -30px 60px rgba(0, 0, 0, 0.6);
      transform: translateY(105%);
      visibility: hidden;
      transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0s linear 0.35s;
    }
    .insp:global(.open) {
      transform: none;
      visibility: visible;
      transition-delay: 0s;
    }
    .insp-bar {
      border-radius: 16px 16px 0 0;
    }
    .close {
      display: inline-block;
    }
    .photo {
      aspect-ratio: 16 / 10;
    }
  }
  @media (max-width: 1199px) and (min-width: 640px) {
    .canvas {
      max-width: 560px;
      width: 100%;
      margin-inline: auto;
    }
  }
</style>

<style>
  @media (max-width: 420px) {
    .hide-xs {
      display: none;
    }
    [data-status-text] {
      display: none;
    }
    .status {
      padding: 6px;
    }
    .bar {
      gap: 12px;
    }
  }
</style>

<style is:global>
  body.sheet-open::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(0, 0, 0, 0.5);
  }
</style>
