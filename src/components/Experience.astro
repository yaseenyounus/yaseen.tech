---
import { experience } from '../data/site';
import Icon from './Icon.astro';
---

<section id="experience" class="section container">
  <span class="eyebrow" data-reveal>Experience</span>
  <h2 class="section-title" data-reveal style="--d:60ms">
    Where I've been<span class="dim"> building.</span>
  </h2>

  <ol class="list">
    {
      experience.map((j, i) => (
        <li data-reveal style={`--d:${i * 50}ms`} class={j.end === 'Present' ? 'current' : ''}>
          <a href={j.href} target="_blank" rel="noopener">
            <span class="when">
              {j.start} — {j.end}
            </span>
            <span class="what">
              <span class="role">{j.role}</span>
              <span class="company">
                {j.company}
                {j.end === 'Present' && <span class="now">Now</span>}
              </span>
            </span>
            <span class="meta">
              <span class="pill">{j.type}</span>
              <span class="pill">{j.location}</span>
            </span>
            <Icon name="arrow" size={18} class="go" />
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .list {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  li {
    border-bottom: 1px solid var(--border);
  }
  a {
    position: relative;
    display: grid;
    grid-template-columns: 170px 1fr auto 24px;
    align-items: center;
    gap: 24px;
    padding: 26px 16px;
    margin-inline: -16px;
    border-radius: var(--radius-sm);
    transition: background 0.35s var(--ease);
  }
  a:hover {
    background: var(--surface-hover);
  }
  .when {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--faint);
    white-space: nowrap;
  }
  .what {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .role {
    font-size: clamp(17px, 2vw, 21px);
    font-weight: 500;
    letter-spacing: -0.02em;
    transition: transform 0.45s var(--ease);
  }
  a:hover .role {
    transform: translateX(4px);
  }
  .company {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .now {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--accent-glow);
  }
  .meta {
    display: flex;
    gap: 6px;
  }
  :global(.go) {
    color: var(--faint);
    transition: color 0.3s, transform 0.4s var(--ease);
  }
  a:hover :global(.go) {
    color: var(--text);
    transform: translate(2px, -2px);
  }
  .current .when {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    a {
      grid-template-columns: 1fr 20px;
      gap: 6px 16px;
      padding: 22px 12px;
      margin-inline: -12px;
    }
    .when {
      grid-column: 1;
      grid-row: 1;
    }
    .what {
      grid-column: 1;
      grid-row: 2;
    }
    .meta {
      grid-column: 1;
      grid-row: 3;
      margin-top: 6px;
    }
    :global(.go) {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
</style>
