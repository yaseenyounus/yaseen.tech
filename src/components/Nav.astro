---
import { nav, profile } from '../data/site';
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Primary">
    <a href="#top" class="logo" aria-label={`${profile.name} — home`}>
      <span>{profile.initials}</span>
    </a>
    <ul>
      {
        nav.map((n) => (
          <li>
            <a href={n.href} data-nav={n.href.slice(1)}>
              {n.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={`mailto:${profile.email}`} class="cta">Say hi</a>
  </nav>
</header>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const map = new Map([...links].map((l) => [l.dataset.nav, l]));
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          links.forEach((l) => l.classList.remove('active'));
          map.get(e.target.id)?.classList.add('active');
        }
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  map.forEach((_, id) => {
    const el = id && document.getElementById(id);
    if (el) obs.observe(el);
  });

  const wrap = document.querySelector('.nav-wrap');
  const onScroll = () => wrap?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav-wrap {
    position: fixed;
    top: 16px;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding-inline: 16px;
    pointer-events: none;
  }
  .nav {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(12, 13, 16, 0.55);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: 0 10px 40px -12px rgba(0, 0, 0, 0.6);
    transition: background 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .scrolled .nav {
    background: rgba(12, 13, 16, 0.8);
    border-color: var(--border-strong);
  }
  .logo {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--text);
    color: #0a0a0b;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: -0.02em;
  }
  ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0 4px;
    gap: 2px;
  }
  ul a {
    display: block;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    color: var(--muted);
    transition: color 0.25s, background 0.25s;
  }
  ul a:hover {
    color: var(--text);
  }
  ul a.active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.07);
  }
  .cta {
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    background: rgba(255, 255, 255, 0.08);
    transition: background 0.25s;
  }
  .cta:hover {
    background: rgba(255, 255, 255, 0.14);
  }
  @media (max-width: 560px) {
    ul a {
      padding: 7px 9px;
      font-size: 13px;
    }
    .cta {
      display: none;
    }
  }
  @media (max-width: 360px) {
    ul li:first-child {
      display: none;
    }
  }
</style>
