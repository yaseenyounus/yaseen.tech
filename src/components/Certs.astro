---
import { Image } from 'astro:assets';
import { certifications, credly } from '../data/site';
import Icon from './Icon.astro';

const certImages = import.meta.glob<{ default: ImageMetadata }>('../assets/certs/*.png', { eager: true });
const badge = (file: string) => certImages[`../assets/certs/${file}.png`].default;
---

<section id="certs" class="section container">
  <div class="head">
    <div>
      <span class="eyebrow" data-reveal>Certifications</span>
      <h2 class="section-title" data-reveal style="--d:60ms">
        {certifications.length} badges<span class="dim">, and counting.</span>
      </h2>
    </div>
    <a class="btn" href={credly} target="_blank" rel="noopener" data-reveal style="--d:120ms">
      Verify on Credly <Icon name="arrow" size={16} />
    </a>
  </div>

  <ul class="wall">
    {
      certifications.map((c, i) => (
        <li class="card" data-reveal style={`--d:${(i % 5) * 50}ms`}>
          <Image src={badge(c.file)} alt="" width={160} height={160} loading="lazy" />
          <span class="name">{c.name}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }
  .wall {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 22px 14px 18px;
    text-align: center;
  }
  li img {
    width: 92px;
    height: 92px;
    filter: grayscale(1) brightness(0.85);
    opacity: 0.85;
    transition: filter 0.5s var(--ease), opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }
  li:hover img {
    filter: none;
    opacity: 1;
    transform: translateY(-3px) scale(1.04);
  }
  .name {
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--muted);
    transition: color 0.3s;
  }
  li:hover .name {
    color: var(--text);
  }
  @media (hover: none) {
    li img {
      filter: none;
      opacity: 1;
    }
  }
  @media (max-width: 880px) {
    .wall {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 520px) {
    .wall {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
    li img {
      width: 76px;
      height: 76px;
    }
  }
</style>
