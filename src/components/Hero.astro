---
import { profile, socials } from '../data/site';
import Icon from './Icon.astro';

const primary = socials.filter((s) => ['github', 'linkedin', 'medium'].includes(s.icon));
---

<section id="top" class="hero container">
  <a class="status" href="#experience" data-reveal>
    <span class="dot" aria-hidden="true"></span>
    {profile.role} at <strong>{profile.company}</strong>
  </a>

  <h1 data-reveal style="--d:80ms">
    {profile.name.split(' ')[0]}<br />
    <span class="grad">{profile.name.split(' ').slice(1).join(' ')}</span>
  </h1>

  <p class="lede" data-reveal style="--d:160ms">{profile.tagline}</p>

  <div class="focus" data-reveal style="--d:220ms">
    {profile.focus.map((f) => <span>{f}</span>)}
  </div>

  <div class="actions" data-reveal style="--d:280ms">
    <a class="btn btn-primary" href="#work">
      See my work <Icon name="arrow" size={16} />
    </a>
    <div class="icons">
      {
        primary.map((s) => (
          <a class="icon-btn" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <Icon name={s.icon} size={17} />
          </a>
        ))
      }
      <a class="icon-btn" href={`mailto:${profile.email}`} aria-label="Email">
        <Icon name="mail" size={17} />
      </a>
    </div>
  </div>

  <div class="orbit" aria-hidden="true">
    <div class="ring r1"><span class="sat" style="--a:0deg"><b>AWS</b></span><span class="sat" style="--a:180deg"><b>Go</b></span></div>
    <div class="ring r2"><span class="sat" style="--a:60deg"><b>Terraform</b></span><span class="sat" style="--a:240deg"><b>Python</b></span></div>
    <div class="ring r3"><span class="sat" style="--a:120deg"><b>CI/CD</b></span><span class="sat" style="--a:300deg"><b>IAM</b></span></div>
    <div class="core"><span>{profile.initials}</span></div>
  </div>

  <a href="#about" class="scroll-hint" aria-label="Scroll to about">
    <span></span>
  </a>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 120px;
    padding-bottom: 96px;
    position: relative;
  }
  .status {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
    font-size: 13px;
    color: var(--muted);
    transition: border-color 0.3s;
  }
  .status:hover {
    border-color: var(--border-strong);
  }
  .status strong {
    color: var(--text);
    font-weight: 500;
    margin-left: -4px;
  }
  .dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes ping {
    75%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(56px, 13vw, 156px);
    line-height: 0.9;
    letter-spacing: -0.055em;
    font-weight: 600;
  }
  .grad {
    background: linear-gradient(100deg, #fff 0%, #c9ccd6 30%, var(--accent) 65%, var(--accent-2) 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: sheen 8s ease-in-out infinite alternate;
  }
  @keyframes sheen {
    to {
      background-position: 100% 0;
    }
  }
  .lede {
    margin-top: 32px;
    max-width: 30ch;
    font-size: clamp(19px, 2.4vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.015em;
    color: var(--muted);
  }
  .focus {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .focus span + span::before {
    content: '/';
    margin-right: 14px;
    color: #33353c;
  }
  @media (max-width: 520px) {
    .focus {
      gap: 6px 8px;
      font-size: 11px;
      letter-spacing: 0.04em;
    }
    .focus span + span::before {
      margin-right: 8px;
    }
  }
  .actions {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .icons {
    display: flex;
    gap: 8px;
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    transition: color 0.25s, border-color 0.25s, background 0.25s, transform 0.3s var(--ease);
  }
  .icon-btn:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-2px);
  }
  .orbit {
    position: absolute;
    right: calc(var(--gutter) - 40px);
    top: 50%;
    width: 500px;
    aspect-ratio: 1;
    translate: 0 -46%;
    z-index: -1;
    animation: fade 1.6s var(--ease) 0.3s both;
  }
  @keyframes fade {
    from {
      opacity: 0;
      scale: 0.94;
    }
  }
  .ring {
    position: absolute;
    inset: var(--i);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.07);
    animation: spin var(--t) linear infinite;
  }
  .r1 {
    --i: 0%;
    --t: 80s;
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.06);
  }
  .r2 {
    --i: 17%;
    --t: 60s;
    animation-direction: reverse;
  }
  .r3 {
    --i: 33%;
    --t: 44s;
    background: radial-gradient(closest-side, rgba(124, 245, 196, 0.06), transparent);
  }
  .sat {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    transform: rotate(var(--a)) translateX(var(--rad));
  }
  .sat b {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: rgba(12, 13, 16, 0.85);
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 11.5px;
    color: #c4c6cf;
    white-space: nowrap;
    /* undo the static angle, then counter the ring's spin so labels stay upright */
    rotate: calc(-1 * var(--a));
    animation: counter var(--t) linear infinite;
  }
  .r2 .sat b {
    animation-direction: reverse;
  }
  @keyframes counter {
    from {
      rotate: calc(-1 * var(--a));
    }
    to {
      rotate: calc(-1 * var(--a) - 360deg);
    }
  }
  .r1 .sat {
    --rad: 250px;
  }
  .r2 .sat {
    --rad: 165px;
  }
  .r3 .sat {
    --rad: 85px;
  }
  .sat b::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 1px;
  }
  .r2 .sat b::before {
    background: var(--accent-2);
  }
  .core {
    position: absolute;
    inset: 44%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--text);
    color: #0a0a0b;
    font-weight: 700;
    letter-spacing: -0.03em;
    box-shadow: 0 0 60px rgba(124, 245, 196, 0.35), 0 0 0 10px rgba(255, 255, 255, 0.03);
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @media (max-width: 1080px) {
    .orbit {
      display: none;
    }
  }
  .scroll-hint {
    position: absolute;
    bottom: 32px;
    left: 50%;
    translate: -50% 0;
    width: 24px;
    height: 38px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
  }
  .scroll-hint span {
    position: absolute;
    top: 8px;
    left: 50%;
    width: 3px;
    height: 7px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--muted);
    animation: wheel 2s var(--ease) infinite;
  }
  @keyframes wheel {
    0% {
      transform: translateY(0);
      opacity: 1;
    }
    80%,
    100% {
      transform: translateY(12px);
      opacity: 0;
    }
  }
  @media (max-height: 640px) {
    .scroll-hint {
      display: none;
    }
  }
</style>
