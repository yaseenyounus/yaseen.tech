---
import { Image } from 'astro:assets';
import photo from '../assets/yaseen.png';
import { profile, stack, certifications, socials } from '../data/site';

const years = new Date().getFullYear() - profile.careerStart;
const github = socials.find((s) => s.label === 'GitHub')!;
const linkedin = socials.find((s) => s.label === 'LinkedIn')!;

const specs = [
  { k: 'Role', v: profile.role },
  { k: 'Company', v: profile.company },
  { k: 'Based', v: profile.location },
  { k: 'Experience', v: `${years}+ years` },
  { k: 'Certs', v: `${certifications.length} active` },
];
---

<section id="top" class="hero">
  <div class="main">
    <p class="mono kicker">
      <span class="accent">■</span> DevSecOps · Cloud · Platform
    </p>

    <h1>
      <span data-scramble>{profile.first}</span><br />
      <span data-scramble>{profile.last}</span><span class="accent">.</span>
    </h1>

    <p class="intro">{profile.intro}</p>

    <div class="cta">
      <a class="btn btn-solid" href="#contact">Get in touch <span class="arrow">↗</span></a>
      <a class="btn" href={github.href} target="_blank" rel="noopener">GitHub <span class="arrow">↗</span></a>
      <a class="btn" href={linkedin.href} target="_blank" rel="noopener">LinkedIn <span class="arrow">↗</span></a>
    </div>

    <ul class="stack mono">
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  <aside class="card">
    <div class="photo">
      <Image src={photo} alt={`Portrait of ${profile.name}`} widths={[360, 540, 720]} sizes="(max-width: 860px) 100vw, 380px" loading="eager" />
      <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
    </div>
    <dl class="specs">
      {
        specs.map((s) => (
          <div>
            <dt class="mono faint">{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))
      }
      <div>
        <dt class="mono faint">Local</dt>
        <dd class="mono clock" data-clock data-tz={profile.timezone}>--:--</dd>
      </div>
    </dl>
  </aside>
</section>

<script>
  // Live local time
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
      timeZone: clock.dataset.tz,
      timeZoneName: 'short',
    });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 1000);
  }

  // Quick decode effect on the name
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&/<>';
    document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el, idx) => {
      const final = el.textContent ?? '';
      el.style.minWidth = `${el.offsetWidth}px`;
      let frame = 0;
      const start = idx * 6;
      const run = () => {
        const out = [...final]
          .map((ch, i) => (frame - start > i * 2.2 ? ch : glyphs[(Math.random() * glyphs.length) | 0]))
          .join('');
        el.textContent = out;
        frame++;
        if (out !== final) requestAnimationFrame(run);
      };
      requestAnimationFrame(run);
    });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 380px;
    padding-top: 56px;
    min-height: min(100svh, 860px);
  }
  .main {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 72px var(--pad);
    border-right: 1px solid var(--line);
    overflow: hidden;
  }
  /* dot matrix */
  .main::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(115deg, transparent 35%, #000 100%);
    opacity: 0.8;
  }
  .kicker {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 11.5px;
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(64px, 11vw, 148px);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }
  h1 span[data-scramble] {
    display: inline-block;
    white-space: nowrap;
  }
  .intro {
    margin-top: 32px;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }
  .cta {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .stack {
    margin-top: 56px;
    display: flex;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    width: fit-content;
    max-width: 100%;
  }
  .stack li {
    padding: 7px 12px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    transition: color 0.2s, background 0.2s;
  }
  .stack li:hover {
    color: var(--text);
    background: var(--hover);
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--panel);
  }
  .photo {
    position: relative;
    aspect-ratio: 1;
    background: #000;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.6s var(--ease);
  }
  .card:hover .photo img {
    filter: none;
  }
  .tick {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent);
    border-style: solid;
    border-width: 0;
  }
  .tl {
    top: 14px;
    left: 14px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .tr {
    top: 14px;
    right: 14px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .bl {
    bottom: 14px;
    left: 14px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .br {
    bottom: 14px;
    right: 14px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .specs {
    margin: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .specs div {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 22px;
    border-bottom: 1px solid var(--line);
  }
  .specs div:last-child {
    border-bottom: 0;
  }
  dt {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 10.5px;
  }
  dd {
    margin: 0;
    font-size: 14px;
    text-align: right;
  }
  .clock {
    font-size: 13px;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr 320px;
    }
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .main {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding-block: 56px 48px;
    }
    .card {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .photo {
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
  }
  @media (max-width: 520px) {
    .card {
      grid-template-columns: 1fr;
    }
    .photo {
      aspect-ratio: 1;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .stack {
      margin-top: 40px;
    }
  }
</style>
