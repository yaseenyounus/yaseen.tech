---
import { openSource, projects, posts, socials } from '../data/site';
import Icon from './Icon.astro';

const medium = socials.find((s) => s.icon === 'medium')!;
const fmt = (d: string) =>
  new Date(d + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<section id="work" class="section container">
  <span class="eyebrow" data-reveal>Selected work</span>
  <h2 class="section-title" data-reveal style="--d:60ms">
    Infrastructure,<span class="dim"> as code.</span>
  </h2>

  <a class="card feature" href={openSource.href} target="_blank" rel="noopener" data-reveal style="--d:80ms">
    <div class="feature-body">
      <span class="pill"><Icon name="github" size={12} /> {openSource.repo}</span>
      <h3>{openSource.title}</h3>
      <p>{openSource.blurb}</p>
      <div class="langs">
        {openSource.langs.map((l) => <span>{l}</span>)}
      </div>
    </div>
    <div class="term" aria-hidden="true">
      <div class="term-bar"><i></i><i></i><i></i><span>cdk deploy</span></div>
      <pre><code><span class="c">$</span> cdk synth && cdk deploy
<span class="m">✓</span> Synthesis time: 4.2s
<span class="m">✓</span> PipelineStack: deploying...
<span class="m">✓</span> EcsFargateService ready
<span class="m">✓</span> CloudFront distribution live
<span class="a">→</span> Stack ARN: arn:aws:cloudformation:…
<span class="c">$</span> <span class="cursor"></span></code></pre>
    </div>
    <Icon name="arrow" size={20} class="corner" />
  </a>

  <ul class="projects">
    {
      projects.map((p, i) => (
        <li class="card project" data-reveal style={`--d:${i * 70}ms`}>
          <div class="tags">
            {p.tags.map((t) => (
              <span>{t}</span>
            ))}
          </div>
          <h3>{p.title}</h3>
          <p>{p.blurb}</p>
          <div class="links">
            {p.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener" aria-label={`${p.title} in ${l.label}`}>
                {l.label} <Icon name="arrow" size={13} />
              </a>
            ))}
          </div>
        </li>
      ))
    }
  </ul>

  <div class="writing">
    <div class="writing-head" data-reveal>
      <span class="eyebrow">Writing</span>
      <a href={medium.href} target="_blank" rel="noopener" class="all">
        All posts on Medium <Icon name="arrow" size={14} />
      </a>
    </div>
    <ul>
      {
        posts.map((p, i) => (
          <li data-reveal style={`--d:${i * 60}ms`}>
            <a href={p.href} target="_blank" rel="noopener">
              <time datetime={p.date}>{fmt(p.date)}</time>
              <span class="t">{p.title}</span>
              <span class="b">{p.blurb}</span>
              <Icon name="arrow" size={16} class="go" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .feature {
    margin-top: 48px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 32px;
    padding: 36px;
    background:
      radial-gradient(600px 300px at 0% 0%, rgba(124, 245, 196, 0.07), transparent 70%),
      var(--surface);
  }
  .feature-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .feature h3 {
    margin-top: 24px;
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .feature p {
    margin-top: 14px;
    max-width: 42ch;
    color: var(--muted);
    font-size: 15.5px;
  }
  .langs {
    margin-top: auto;
    padding-top: 28px;
    display: flex;
    gap: 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--muted);
  }
  .langs span::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--c);
  }
  .langs span:nth-child(1) {
    --c: #00add8;
  }
  .langs span:nth-child(2) {
    --c: #f7d046;
  }
  .langs span:nth-child(3) {
    --c: #3178c6;
  }
  .term {
    align-self: center;
    border-radius: 14px;
    border: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.45);
    overflow: hidden;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
    transition: transform 0.6s var(--ease);
  }
  .feature:hover .term {
    transform: translateY(-4px);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }
  .term-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2a2c33;
  }
  .term-bar span {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
  }
  pre {
    margin: 0;
    padding: 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.8;
    color: #b9bcc6;
    white-space: pre-wrap;
    word-break: break-all;
  }
  .c {
    color: var(--faint);
  }
  .m {
    color: var(--accent);
  }
  .a {
    color: var(--accent-2);
  }
  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    vertical-align: -2px;
    background: var(--text);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .feature :global(.corner) {
    position: absolute;
    top: 24px;
    right: 24px;
    color: var(--faint);
    transition: color 0.3s, transform 0.4s var(--ease);
  }
  .feature:hover :global(.corner) {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  .projects {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .project {
    padding: 26px;
    display: flex;
    flex-direction: column;
    min-height: 240px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .project h3 {
    margin-top: 28px;
    font-size: 20px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .project p {
    margin-top: 8px;
    font-size: 14.5px;
    color: var(--muted);
  }
  .links {
    margin-top: auto;
    padding-top: 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 13px;
    color: #c4c6cf;
    transition: border-color 0.25s, background 0.25s, color 0.25s;
  }
  .links a:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.05);
  }

  .writing {
    margin-top: clamp(64px, 9vw, 104px);
  }
  .writing-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
    transition: color 0.25s;
  }
  .all:hover {
    color: var(--text);
  }
  .writing ul {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .writing li {
    border-bottom: 1px solid var(--border);
  }
  .writing li a {
    display: grid;
    grid-template-columns: 110px auto 1fr 20px;
    align-items: baseline;
    gap: 20px;
    padding: 20px 16px;
    margin-inline: -16px;
    border-radius: var(--radius-sm);
    transition: background 0.3s var(--ease);
  }
  .writing li a:hover {
    background: var(--surface-hover);
  }
  time {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--faint);
  }
  .t {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.015em;
  }
  .b {
    color: var(--faint);
    font-size: 14.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .writing :global(.go) {
    align-self: center;
    color: var(--faint);
    transition: color 0.3s, transform 0.4s var(--ease);
  }
  .writing li a:hover :global(.go) {
    color: var(--text);
    transform: translate(2px, -2px);
  }

  @media (max-width: 880px) {
    .feature {
      grid-template-columns: 1fr;
      padding: 28px;
    }
    .projects {
      grid-template-columns: 1fr;
    }
    .project {
      min-height: 0;
    }
  }
  @media (max-width: 620px) {
    .feature {
      padding: 22px;
    }
    .writing li a {
      grid-template-columns: 1fr 18px;
      gap: 4px 12px;
      padding: 18px 12px;
      margin-inline: -12px;
    }
    time {
      grid-row: 1;
    }
    .t {
      grid-row: 2;
    }
    .b {
      display: none;
    }
    .writing :global(.go) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
